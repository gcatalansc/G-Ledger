  "required": [
    "active_phases",
    "authority_documents",
    "checkpoint",
    "conflict_refs",
    "current_decisions",
    "digest",
    "gates",
    "last_material_activity_at",
    "next_actions",
    "open_blockers",
    "open_risks",
    "primary_active_phase_ref",
    "project",
    "project_continuity_projection_id",
    "provenance_ref",
    "recent_material_events",
    "repository_binding",
    "schema_version",
    "source_profile",
    "unknowns",
    "verified_completed_phases"
  ],
  "title": "ProjectContinuityProjection",
  "type": "object"
}
