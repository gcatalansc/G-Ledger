{
  "$id": "urn:gskills:schema:project-continuity-projection:0.3.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Closed durable v0.3 contract surface derived from the normative example and section 19.2.",
  "properties": {
    "active_phases": {
      "items": {
        "additionalProperties": false,
