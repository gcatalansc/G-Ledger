          "extensions": {
            "additionalProperties": true,
            "propertyNames": {
              "pattern": "^[a-z][a-z0-9.-]*/[A-Za-z0-9._-]+$"
            },
            "type": "object"
          },
          "ref": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "ref"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "authority_documents": {
      "items": true,
      "type": "array"
    },
    "checkpoint": {
      "additionalProperties": true,
      "type": "object"
    },
    "conflict_refs": {
      "items": true,
      "type": "array"
    },
    "current_decisions": {
      "items": true,
      "type": "array"
    },
    "digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "extensions": {
      "additionalProperties": true,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9.-]*/[A-Za-z0-9._-]+$"
      },
      "type": "object"
    },
    "gates": {
      "additionalProperties": true,
      "type": "object"
    },
    "last_material_activity_at": {
      "type": "string"
    },
    "next_actions": {
      "additionalProperties": false,
      "properties": {
        "extensions": {
          "additionalProperties": true,
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9.-]*/[A-Za-z0-9._-]+$"
          },
          "type": "object"
        },
        "ordered": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "extensions": {
                "additionalProperties": true,
                "propertyNames": {
                  "pattern": "^[a-z][a-z0-9.-]*/[A-Za-z0-9._-]+$"
                },
                "type": "object"
              },
              "ref": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "ref"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "preferred_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "ordered"
      ],
      "type": "object"
    },
    "open_blockers": {
      "items": true,
      "type": "array"
    },
    "open_risks": {
      "items": true,
      "type": "array"
    },
    "primary_active_phase_ref": {
      "type": "string"
    },
    "project": {
      "additionalProperties": true,
      "type": "object"
    },
    "project_continuity_projection_id": {
      "minLength": 1,
      "type": "string"
    },
    "provenance_ref": {
      "type": "string"
    },
    "recent_material_events": {
      "items": true,
      "type": "array"
    },
    "repository_binding": {
      "additionalProperties": true,
      "type": "object"
    },
    "schema_version": {
      "const": "0.3.0"
    },
    "source_profile": {
      "type": "string"
    },
    "unknowns": {
      "items": true,
      "type": "array"
