{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema://contracts/checkpoint-create-request",
  "title": "CheckpointCreateRequest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "reason",
    "state_snapshot",
    "memory_writes_since_last",
    "actions_since_last"
  ],
  "properties": {
    "reason": {
      "type": "string"
    },
    "state_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "working_memory",
        "pending_goals",
        "open_questions",
        "tool_state",
        "turn_count",
        "last_user_input",
        "last_response_summary",
        "open_loops",
        "authoritative_state_refs",
        "high_watermarks"
      ],
      "properties": {
        "working_memory": {
          "type": "object",
          "additionalProperties": true
        },
        "pending_goals": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "open_questions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tool_state": {
          "type": "object",
          "additionalProperties": true
        },
        "turn_count": {
          "type": "integer",
          "minimum": 0
        },
        "last_user_input": {
          "type": "string"
        },
        "last_response_summary": {
          "type": "string"
        },
        "open_loops": {
          "type": "array",
          "items": {
            "$ref": "open.loop.schema.json"
          }
        },
        "authoritative_state_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "high_watermarks": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/highWatermark"
          }
        }
      }
    },
    "memory_writes_since_last": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "actions_since_last": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "applied_commit_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
