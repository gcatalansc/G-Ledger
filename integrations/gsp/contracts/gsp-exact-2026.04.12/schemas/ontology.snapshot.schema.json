{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema://contracts/ontology-snapshot",
  "title": "OntologySnapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ontology_version",
    "snapshot_manifest_ref",
    "type_hierarchy_ref",
    "predicate_registry_ref",
    "relation_constraints_ref",
    "alias_maps_ref",
    "kb_snapshot_ref",
    "shacl_shapes_ref",
    "shacl_rules_ref",
    "rdf_projection_ref",
    "provenance_profile_ref"
