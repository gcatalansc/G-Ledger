    "snapshot_manifest_ref": {
      "$ref": "common.schema.json#/$defs/ontologyAssetRef"
    },
    "type_hierarchy_ref": {
      "$ref": "common.schema.json#/$defs/ontologyAssetRef"
    },
    "predicate_registry_ref": {
      "$ref": "common.schema.json#/$defs/ontologyAssetRef"
    },
    "relation_constraints_ref": {
      "$ref": "common.schema.json#/$defs/ontologyAssetRef"
    },
    "alias_maps_ref": {
      "$ref": "common.schema.json#/$defs/ontologyAssetRef"
    },
    "kb_snapshot_ref": {
      "$ref": "common.schema.json#/$defs/ontologyAssetRef"
    },
    "shacl_shapes_ref": {
      "$ref": "common.schema.json#/$defs/ontologyAssetRef"
    },
    "shacl_rules_ref": {
      "$ref": "common.schema.json#/$defs/ontologyAssetRef"
    },
    "rdf_projection_ref": {
      "$ref": "common.schema.json#/$defs/ontologyAssetRef"
    },
    "provenance_profile_ref": {
      "$ref": "common.schema.json#/$defs/ontologyAssetRef"
    }
  }
}
