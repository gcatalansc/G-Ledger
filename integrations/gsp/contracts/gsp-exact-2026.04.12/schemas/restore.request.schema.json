{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema://contracts/restore-request",
  "title": "RestoreRequest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "checkpoint_id",
    "restore_reason"
  ],
  "properties": {
    "checkpoint_id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "restore_reason": {
      "type": "string"
    },
    "rehydrate_to_high_watermark": {
      "type": "boolean"
    },
    "skip_action_replay": {
      "type": "boolean"
    }
  }
}
