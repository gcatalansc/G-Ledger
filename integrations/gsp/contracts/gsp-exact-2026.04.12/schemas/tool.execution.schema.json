{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema://contracts/tool-execution",
  "title": "ToolExecution",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "execution_id",
    "approval_source",
    "result_status",
    "input_hash",
    "actor",
    "session_id",
    "trace_id",
    "tool_name",
    "input",
    "output",
    "status",
    "tokens_in_result",
    "started_at",
    "consumed"
  ],
  "properties": {
    "execution_id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "tool_name": {
      "type": "string"
    },
    "input": {
      "type": "object",
      "additionalProperties": true
    },
    "output": {
      "type": "object",
      "additionalProperties": true
    },
    "status": {
      "$ref": "common.schema.json#/$defs/toolExecutionStatus"
    },
    "tokens_in_result": {
      "type": "integer",
      "minimum": 0
    },
    "started_at": {
      "$ref": "common.schema.json#/$defs/datetime"
    },
    "completed_at": {
      "$ref": "common.schema.json#/$defs/datetime"
    },
    "side_effects": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "consumed": {
      "type": "boolean"
    },
    "trace_id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "session_id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "actor": {
      "$ref": "common.schema.json#/$defs/actorId"
    },
    "input_hash": {
      "$ref": "common.schema.json#/$defs/sha256Hex"
    },
    "result_status": {
      "$ref": "common.schema.json#/$defs/toolResultStatus"
    },
    "approval_source": {
      "$ref": "common.schema.json#/$defs/approvalSource"
    }
  }
}
