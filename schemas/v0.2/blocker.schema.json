{
  "$defs": {
    "BlockerStatus": {
      "enum": [
        "OPEN",
        "MITIGATED",
        "RESOLVED",
        "ACCEPTED",
        "CANCELLED"
      ],
      "type": "string"
    },
    "LedgerTimestamp": {
      "description": "A validated RFC 3339 timestamp with an explicit UTC offset.",
      "format": "date-time",
      "type": "string"
    },
    "ResourceRef": {
      "description": "An absolute, minimized resource reference.",
      "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:.+$",
      "type": "string"
    },
    "SchemaVersion": {
      "description": "Supported durable contract versions in the first contract slice.",
      "enum": [
        "0.2.0",
        "0.1.1"
      ],
      "type": "string"
    },
    "ScopeKind": {
      "enum": [
        "PROJECT",
        "PHASE",
        "GATE",
        "DECISION",
        "REPOSITORY",
        "EXTERNAL"
      ],
      "type": "string"
    },
    "Severity": {
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH",
        "CRITICAL"
      ],
      "type": "string"
    },
    "Sha256Digest": {
      "description": "A canonical lowercase SHA-256 digest with the `sha256:` prefix.",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "StableId": {
      "description": "A compact stable identifier for phases, gates, decisions, and related records.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
      "type": "string"
    }
  },
  "$id": "urn:project-ledger:schema:blocker:0.2.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "blocker_id": {
      "$ref": "#/$defs/StableId"
    },
    "description": {
      "type": "string"
    },
    "digest": {
      "$ref": "#/$defs/Sha256Digest"
    },
    "evidence_refs": {
      "items": {
        "$ref": "#/$defs/StableId"
      },
      "type": "array"
    },
    "opened_at": {
      "$ref": "#/$defs/LedgerTimestamp"
    },
    "owner_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/StableId"
        },
        {
          "type": "null"
        }
      ]
    },
    "provenance_ref": {
      "$ref": "#/$defs/ResourceRef"
    },
    "resolution_summary": {
      "type": [
        "string",
        "null"
      ]
    },
    "resolved_at": {
      "anyOf": [
        {
          "$ref": "#/$defs/LedgerTimestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "schema_version": {
      "$ref": "#/$defs/SchemaVersion"
    },
    "scope_kind": {
      "$ref": "#/$defs/ScopeKind"
    },
    "scope_ref": {
      "$ref": "#/$defs/StableId"
    },
    "severity": {
      "$ref": "#/$defs/Severity"
    },
    "source_kind": {
      "type": "string"
    },
    "source_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/ResourceRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "$ref": "#/$defs/BlockerStatus"
    },
    "title": {
      "type": "string"
    },
    "updated_at": {
      "$ref": "#/$defs/LedgerTimestamp"
    }
  },
  "required": [
    "schema_version",
    "blocker_id",
    "title",
    "description",
    "scope_kind",
    "scope_ref",
    "severity",
    "status",
    "source_kind",
    "evidence_refs",
    "opened_at",
    "updated_at",
    "provenance_ref",
    "digest"
  ],
  "title": "Blocker",
  "type": "object"
}
