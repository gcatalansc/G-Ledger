{
  "$defs": {
    "CheckpointFreshnessStatus": {
      "enum": [
        "CURRENT",
        "CURRENT_FOR_PROJECT_ONLY",
        "STALE_FOR_REPOSITORY",
        "STALE_FOR_AUTHORITY",
        "SUPERSEDED_BY_NEWER_CHECKPOINT",
        "CONFLICTED",
        "INVALIDATED",
        "UNKNOWN"
      ],
      "type": "string"
    },
    "LedgerTimestamp": {
      "description": "A validated RFC 3339 timestamp with an explicit UTC offset.",
      "format": "date-time",
      "type": "string"
    },
    "SchemaVersion": {
      "description": "Supported durable contract versions in the first contract slice.",
      "enum": [
        "0.2.0",
        "0.1.1"
      ],
      "type": "string"
    },
    "Sha256Digest": {
      "description": "A canonical lowercase SHA-256 digest with the `sha256:` prefix.",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "StableId": {
      "description": "A compact stable identifier for phases, gates, decisions, and related records.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
      "type": "string"
    }
  },
  "$id": "urn:project-ledger:schema:checkpoint-freshness-record:0.2.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "checkpoint_ref": {
      "$ref": "#/$defs/StableId"
    },
    "digest": {
      "$ref": "#/$defs/Sha256Digest"
    },
    "evaluated_at": {
      "$ref": "#/$defs/LedgerTimestamp"
    },
    "freshness_record_id": {
      "$ref": "#/$defs/StableId"
    },
    "reason_codes": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "schema_version": {
      "$ref": "#/$defs/SchemaVersion"
    },
    "status": {
      "$ref": "#/$defs/CheckpointFreshnessStatus"
    }
  },
  "required": [
    "schema_version",
    "freshness_record_id",
    "checkpoint_ref",
    "status",
    "evaluated_at",
    "reason_codes",
    "digest"
  ],
  "title": "CheckpointFreshnessRecord",
  "type": "object"
}
