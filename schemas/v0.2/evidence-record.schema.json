{
  "$defs": {
    "EvidenceArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "$ref": "#/$defs/Sha256Digest"
        },
        "persisted": {
          "type": "boolean"
        },
        "uri": {
          "$ref": "#/$defs/ResourceRef"
        }
      },
      "required": [
        "uri",
        "digest",
        "persisted"
      ],
      "type": "object"
    },
    "EvidenceKind": {
      "enum": [
        "TEST_RESULT",
        "BUILD_RESULT",
        "LINT_RESULT",
        "FORMAT_RESULT",
        "TYPECHECK_RESULT",
        "SECURITY_SCAN_RESULT",
        "PRIVACY_SCAN_RESULT",
        "BENCHMARK_RESULT",
        "SMOKE_RESULT",
        "E2E_RESULT",
        "MANUAL_REVIEW",
        "ARTIFACT_DIGEST",
        "FILE_EXISTENCE",
        "SCHEMA_VALIDATION",
        "MIGRATION_RESULT",
        "EXTERNAL_VERIFIED_EVIDENCE",
        "CUSTOM_DECLARATIVE"
      ],
      "type": "string"
    },
    "EvidenceMetrics": {
      "additionalProperties": false,
      "properties": {
        "errors": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "failed": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "passed": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "skipped": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "EvidencePrivacy": {
      "additionalProperties": false,
      "properties": {
        "raw_output_stored": {
          "type": "boolean"
        },
        "redaction_applied": {
          "type": "boolean"
        }
      },
      "required": [
        "raw_output_stored",
        "redaction_applied"
      ],
      "type": "object"
    },
    "EvidenceResult": {
      "additionalProperties": false,
      "properties": {
        "duration_ms": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "exit_code": {
          "format": "int32",
          "type": [
            "integer",
            "null"
          ]
        },
        "metrics": {
          "$ref": "#/$defs/EvidenceMetrics"
        },
        "summary": {
          "type": "string"
        }
      },
      "required": [
        "duration_ms",
        "metrics",
        "summary"
      ],
      "type": "object"
    },
    "EvidenceSource": {
      "additionalProperties": false,
      "properties": {
        "command_display": {
          "type": [
            "string",
            "null"
          ]
        },
        "runner_version": {
          "type": "string"
        },
        "source_type": {
          "$ref": "#/$defs/EvidenceSourceType"
        },
        "tool": {
          "type": "string"
        },
        "working_directory_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ResourceRef"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "source_type",
        "tool",
        "runner_version"
      ],
      "type": "object"
    },
    "EvidenceSourceType": {
      "enum": [
        "COMMAND_EXECUTION",
        "IMPORTED_ARTIFACT",
        "EXTERNAL_SYSTEM",
        "MANUAL_REVIEW"
      ],
      "type": "string"
    },
    "EvidenceStatus": {
      "enum": [
        "ASSERTED",
        "OBSERVED",
        "VERIFIED_SOURCE",
        "REJECTED",
        "STALE",
        "INVALIDATED",
        "UNAVAILABLE"
      ],
      "type": "string"
    },
    "LedgerTimestamp": {
      "description": "A validated RFC 3339 timestamp with an explicit UTC offset.",
      "format": "date-time",
      "type": "string"
    },
    "RepositorySnapshot": {
      "additionalProperties": false,
      "description": "A reproducible repository snapshot reference.",
      "properties": {
        "repository_ref": {
          "$ref": "#/$defs/StableId"
        },
        "snapshot_digest": {
          "$ref": "#/$defs/Sha256Digest"
        },
        "snapshot_ref": {
          "$ref": "#/$defs/StableId"
        }
      },
      "required": [
        "repository_ref",
        "snapshot_ref",
        "snapshot_digest"
      ],
      "type": "object"
    },
    "ResourceRef": {
      "description": "An absolute, minimized resource reference.",
      "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:.+$",
      "type": "string"
    },
    "SchemaVersion": {
      "description": "Supported durable contract versions in the first contract slice.",
      "enum": [
        "0.2.0",
        "0.1.1"
      ],
      "type": "string"
    },
    "Sha256Digest": {
      "description": "A canonical lowercase SHA-256 digest with the `sha256:` prefix.",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "StableId": {
      "description": "A compact stable identifier for phases, gates, decisions, and related records.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
      "type": "string"
    }
  },
  "$id": "urn:project-ledger:schema:evidence-record:0.2.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifacts": {
      "items": {
        "$ref": "#/$defs/EvidenceArtifactRef"
      },
      "type": "array"
    },
    "evidence_id": {
      "$ref": "#/$defs/StableId"
    },
    "kind": {
      "$ref": "#/$defs/EvidenceKind"
    },
    "observed_at": {
      "$ref": "#/$defs/LedgerTimestamp"
    },
    "payload_digest": {
      "$ref": "#/$defs/Sha256Digest"
    },
    "privacy": {
      "$ref": "#/$defs/EvidencePrivacy"
    },
    "project_ref": {
      "type": "string"
    },
    "provenance_ref": {
      "$ref": "#/$defs/ResourceRef"
    },
    "repository_binding": {
      "anyOf": [
        {
          "$ref": "#/$defs/RepositorySnapshot"
        },
        {
          "type": "null"
        }
      ]
    },
    "result": {
      "$ref": "#/$defs/EvidenceResult"
    },
    "schema_version": {
      "$ref": "#/$defs/SchemaVersion"
    },
    "source": {
      "$ref": "#/$defs/EvidenceSource"
    },
    "status": {
      "$ref": "#/$defs/EvidenceStatus"
    }
  },
  "required": [
    "schema_version",
    "evidence_id",
    "project_ref",
    "kind",
    "status",
    "source",
    "result",
    "artifacts",
    "privacy",
    "observed_at",
    "payload_digest",
    "provenance_ref"
  ],
  "title": "EvidenceRecord",
  "type": "object"
}
