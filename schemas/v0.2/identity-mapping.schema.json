{
  "$defs": {
    "IdentityMappingStatus": {
      "enum": [
        "CANDIDATE",
        "CONFIRMED",
        "REVOKED",
        "CONFLICTED"
      ],
      "type": "string"
    },
    "IdentityMethod": {
      "enum": [
        "EXPLICIT_ID",
        "REMOTE_DIGEST",
        "SIGNED_BINDING",
        "USER_CONFIRMED",
        "IMPORTED_MAPPING_REVIEWED"
      ],
      "type": "string"
    },
    "LedgerTimestamp": {
      "description": "A validated RFC 3339 timestamp with an explicit UTC offset.",
      "format": "date-time",
      "type": "string"
    },
    "ResourceRef": {
      "description": "An absolute, minimized resource reference.",
      "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:.+$",
      "type": "string"
    },
    "SchemaVersion": {
      "description": "Supported durable contract versions in the first contract slice.",
      "enum": [
        "0.2.0",
        "0.1.1"
      ],
      "type": "string"
    },
    "Sha256Digest": {
      "description": "A canonical lowercase SHA-256 digest with the `sha256:` prefix.",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "StableId": {
      "description": "A compact stable identifier for phases, gates, decisions, and related records.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
      "type": "string"
    }
  },
  "$id": "urn:project-ledger:schema:identity-mapping:0.2.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "confirmed_by": {
      "anyOf": [
        {
          "$ref": "#/$defs/StableId"
        },
        {
          "type": "null"
        }
      ]
    },
    "created_at": {
      "$ref": "#/$defs/LedgerTimestamp"
    },
    "digest": {
      "$ref": "#/$defs/Sha256Digest"
    },
    "external_ref": {
      "$ref": "#/$defs/ResourceRef"
    },
    "external_system": {
      "type": "string"
    },
    "local_ref": {
      "$ref": "#/$defs/ResourceRef"
    },
    "mapping_id": {
      "$ref": "#/$defs/StableId"
    },
    "method": {
      "$ref": "#/$defs/IdentityMethod"
    },
    "schema_version": {
      "$ref": "#/$defs/SchemaVersion"
    },
    "status": {
      "$ref": "#/$defs/IdentityMappingStatus"
    },
    "updated_at": {
      "$ref": "#/$defs/LedgerTimestamp"
    }
  },
  "required": [
    "schema_version",
    "mapping_id",
    "local_ref",
    "external_system",
    "external_ref",
    "method",
    "status",
    "created_at",
    "updated_at",
    "digest"
  ],
  "title": "IdentityMapping",
  "type": "object"
}
