{
  "$defs": {
    "LedgerTimestamp": {
      "description": "A validated RFC 3339 timestamp with an explicit UTC offset.",
      "format": "date-time",
      "type": "string"
    },
    "LossItem": {
      "additionalProperties": false,
      "properties": {
        "field_path": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/LossSeverity"
        }
      },
      "required": [
        "field_path",
        "severity",
        "reason"
      ],
      "type": "object"
    },
    "LossSeverity": {
      "enum": [
        "INFORMATIONAL",
        "MATERIAL",
        "CRITICAL"
      ],
      "type": "string"
    },
    "ResourceRef": {
      "description": "An absolute, minimized resource reference.",
      "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:.+$",
      "type": "string"
    },
    "SchemaVersion": {
      "description": "Supported durable contract versions in the first contract slice.",
      "enum": [
        "0.2.0",
        "0.1.1"
      ],
      "type": "string"
    },
    "Sha256Digest": {
      "description": "A canonical lowercase SHA-256 digest with the `sha256:` prefix.",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "StableId": {
      "description": "A compact stable identifier for phases, gates, decisions, and related records.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
      "type": "string"
    }
  },
  "$id": "urn:project-ledger:schema:loss-report:0.2.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "created_at": {
      "$ref": "#/$defs/LedgerTimestamp"
    },
    "digest": {
      "$ref": "#/$defs/Sha256Digest"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/LossItem"
      },
      "type": "array"
    },
    "loss_report_id": {
      "$ref": "#/$defs/StableId"
    },
    "material_loss_count": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "schema_version": {
      "$ref": "#/$defs/SchemaVersion"
    },
    "source_schema_ref": {
      "$ref": "#/$defs/ResourceRef"
    },
    "target_schema_ref": {
      "$ref": "#/$defs/ResourceRef"
    }
  },
  "required": [
    "schema_version",
    "loss_report_id",
    "source_schema_ref",
    "target_schema_ref",
    "items",
    "material_loss_count",
    "created_at",
    "digest"
  ],
  "title": "LossReport",
  "type": "object"
}
