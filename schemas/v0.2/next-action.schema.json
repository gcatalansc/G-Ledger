{
  "$defs": {
    "LedgerTimestamp": {
      "description": "A validated RFC 3339 timestamp with an explicit UTC offset.",
      "format": "date-time",
      "type": "string"
    },
    "NextActionClassification": {
      "enum": [
        "AUTHORIZED",
        "ELIGIBLE",
        "RECOMMENDED",
        "PROPOSED",
        "BLOCKED",
        "COMPLETED",
        "CANCELLED"
      ],
      "type": "string"
    },
    "ResourceRef": {
      "description": "An absolute, minimized resource reference.",
      "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:.+$",
      "type": "string"
    },
    "SchemaVersion": {
      "description": "Supported durable contract versions in the first contract slice.",
      "enum": [
        "0.2.0",
        "0.1.1"
      ],
      "type": "string"
    },
    "Sha256Digest": {
      "description": "A canonical lowercase SHA-256 digest with the `sha256:` prefix.",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "StableId": {
      "description": "A compact stable identifier for phases, gates, decisions, and related records.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
      "type": "string"
    }
  },
  "$id": "urn:project-ledger:schema:next-action:0.2.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authority_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/StableId"
        },
        {
          "type": "null"
        }
      ]
    },
    "blocked_by_refs": {
      "items": {
        "$ref": "#/$defs/StableId"
      },
      "type": "array"
    },
    "classification": {
      "$ref": "#/$defs/NextActionClassification"
    },
    "completed_at": {
      "anyOf": [
        {
          "$ref": "#/$defs/LedgerTimestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "created_at": {
      "$ref": "#/$defs/LedgerTimestamp"
    },
    "description": {
      "type": "string"
    },
    "digest": {
      "$ref": "#/$defs/Sha256Digest"
    },
    "gate_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/StableId"
        },
        {
          "type": "null"
        }
      ]
    },
    "next_action_id": {
      "$ref": "#/$defs/StableId"
    },
    "owner_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/StableId"
        },
        {
          "type": "null"
        }
      ]
    },
    "phase_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/StableId"
        },
        {
          "type": "null"
        }
      ]
    },
    "precondition_refs": {
      "items": {
        "$ref": "#/$defs/StableId"
      },
      "type": "array"
    },
    "provenance_ref": {
      "$ref": "#/$defs/ResourceRef"
    },
    "schema_version": {
      "$ref": "#/$defs/SchemaVersion"
    },
    "title": {
      "type": "string"
    },
    "updated_at": {
      "$ref": "#/$defs/LedgerTimestamp"
    }
  },
  "required": [
    "schema_version",
    "next_action_id",
    "title",
    "description",
    "classification",
    "precondition_refs",
    "blocked_by_refs",
    "created_at",
    "updated_at",
    "provenance_ref",
    "digest"
  ],
  "title": "NextAction",
  "type": "object"
}
