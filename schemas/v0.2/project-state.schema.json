{
  "$defs": {
    "AuthorityDocument": {
      "additionalProperties": false,
      "properties": {
        "authority_rank": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "digest": {
          "$ref": "#/$defs/Sha256Digest"
        },
        "document_id": {
          "$ref": "#/$defs/StableId"
        },
        "effective_from": {
          "$ref": "#/$defs/LedgerTimestamp"
        },
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion"
        },
        "status": {
          "$ref": "#/$defs/AuthorityDocumentStatus"
        },
        "supersedes_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/StableId"
            },
            {
              "type": "null"
            }
          ]
        },
        "uri": {
          "$ref": "#/$defs/ResourceRef"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "document_id",
        "uri",
        "digest",
        "version",
        "status",
        "authority_rank",
        "effective_from"
      ],
      "type": "object"
    },
    "AuthorityDocumentStatus": {
      "enum": [
        "CURRENT",
        "DRAFT",
        "LEGACY",
        "DEPRECATED",
        "SUPERSEDED",
        "UNAVAILABLE",
        "DIGEST_MISMATCH"
      ],
      "type": "string"
    },
    "AuthorityPolicy": {
      "enum": [
        "SPEC_FIRST"
      ],
      "type": "string"
    },
    "LedgerTimestamp": {
      "description": "A validated RFC 3339 timestamp with an explicit UTC offset.",
      "format": "date-time",
      "type": "string"
    },
    "Project": {
      "additionalProperties": false,
      "properties": {
        "archived_at": {
          "anyOf": [
            {
              "$ref": "#/$defs/LedgerTimestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "authority_policy": {
          "$ref": "#/$defs/AuthorityPolicy"
        },
        "created_at": {
          "$ref": "#/$defs/LedgerTimestamp"
        },
        "lifecycle_status": {
          "$ref": "#/$defs/ProjectLifecycleStatus"
        },
        "paused_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "project_id": {
          "type": "string"
        },
        "repository_binding_refs": {
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "type": "array"
        },
        "storage_profile": {
          "$ref": "#/$defs/StorageProfile"
        },
        "summary": {
          "type": "string"
        },
        "timezone": {
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "project_id",
        "title",
        "summary",
        "lifecycle_status",
        "created_at",
        "timezone",
        "authority_policy",
        "storage_profile",
        "repository_binding_refs"
      ],
      "type": "object"
    },
    "ProjectLifecycleStatus": {
      "enum": [
        "INITIALIZING",
        "ACTIVE",
        "PAUSED",
        "BLOCKED",
        "COMPLETED",
        "ARCHIVED"
      ],
      "type": "string"
    },
    "ResourceRef": {
      "description": "An absolute, minimized resource reference.",
      "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:.+$",
      "type": "string"
    },
    "Roadmap": {
      "additionalProperties": false,
      "properties": {
        "completion_policy": {
          "$ref": "#/$defs/RoadmapCompletionPolicy"
        },
        "execution_model": {
          "$ref": "#/$defs/RoadmapExecutionModel"
        },
        "phase_order": {
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "type": "array"
        },
        "roadmap_id": {
          "$ref": "#/$defs/StableId"
        },
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion"
        },
        "source_document_ref": {
          "$ref": "#/$defs/StableId"
        },
        "title": {
          "type": "string"
        },
        "version": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "schema_version",
        "roadmap_id",
        "title",
        "execution_model",
        "phase_order",
        "completion_policy",
        "version",
        "source_document_ref"
      ],
      "type": "object"
    },
    "RoadmapCompletionPolicy": {
      "enum": [
        "ALL_REQUIRED_PHASES"
      ],
      "type": "string"
    },
    "RoadmapExecutionModel": {
      "enum": [
        "SEQUENTIAL"
      ],
      "type": "string"
    },
    "SchemaVersion": {
      "description": "Supported durable contract versions in the first contract slice.",
      "enum": [
        "0.2.0",
        "0.1.1"
      ],
      "type": "string"
    },
    "Sha256Digest": {
      "description": "A canonical lowercase SHA-256 digest with the `sha256:` prefix.",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "StableId": {
      "description": "A compact stable identifier for phases, gates, decisions, and related records.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
      "type": "string"
    },
    "StorageProfile": {
      "enum": [
        "USER_DATA",
        "PORTABLE"
      ],
      "type": "string"
    }
  },
  "$id": "urn:project-ledger:schema:project-state:0.2.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "active_phase_refs": {
      "items": {
        "$ref": "#/$defs/StableId"
      },
      "type": "array"
    },
    "authority_documents": {
      "items": {
        "$ref": "#/$defs/AuthorityDocument"
      },
      "type": "array"
    },
    "checkpoint_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/StableId"
        },
        {
          "type": "null"
        }
      ]
    },
    "completed_phase_refs": {
      "items": {
        "$ref": "#/$defs/StableId"
      },
      "type": "array"
    },
    "current_decision_refs": {
      "items": {
        "$ref": "#/$defs/StableId"
      },
      "type": "array"
    },
    "last_material_activity_at": {
      "anyOf": [
        {
          "$ref": "#/$defs/LedgerTimestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "last_material_event_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "material_state_version": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "open_blocker_refs": {
      "items": {
        "$ref": "#/$defs/StableId"
      },
      "type": "array"
    },
    "open_conflict_refs": {
      "items": {
        "$ref": "#/$defs/StableId"
      },
      "type": "array"
    },
    "open_risk_refs": {
      "items": {
        "$ref": "#/$defs/StableId"
      },
      "type": "array"
    },
    "ordered_next_action_refs": {
      "items": {
        "$ref": "#/$defs/StableId"
      },
      "type": "array"
    },
    "pending_gate_refs": {
      "items": {
        "$ref": "#/$defs/StableId"
      },
      "type": "array"
    },
    "preferred_next_action_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/StableId"
        },
        {
          "type": "null"
        }
      ]
    },
    "primary_active_phase_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/StableId"
        },
        {
          "type": "null"
        }
      ]
    },
    "project": {
      "$ref": "#/$defs/Project"
    },
    "project_state_id": {
      "$ref": "#/$defs/StableId"
    },
    "revalidation_required_gate_refs": {
      "items": {
        "$ref": "#/$defs/StableId"
      },
      "type": "array"
    },
    "roadmap": {
      "anyOf": [
        {
          "$ref": "#/$defs/Roadmap"
        },
        {
          "type": "null"
        }
      ]
    },
    "schema_version": {
      "$ref": "#/$defs/SchemaVersion"
    },
    "state_digest": {
      "$ref": "#/$defs/Sha256Digest"
    },
    "state_version": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "updated_at": {
      "$ref": "#/$defs/LedgerTimestamp"
    },
    "verified_gate_refs": {
      "items": {
        "$ref": "#/$defs/StableId"
      },
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "project_state_id",
    "project",
    "state_version",
    "material_state_version",
    "authority_documents",
    "active_phase_refs",
    "completed_phase_refs",
    "pending_gate_refs",
    "verified_gate_refs",
    "revalidation_required_gate_refs",
    "current_decision_refs",
    "open_blocker_refs",
    "open_risk_refs",
    "ordered_next_action_refs",
    "open_conflict_refs",
    "updated_at",
    "state_digest"
  ],
  "title": "ProjectState",
  "type": "object"
}
