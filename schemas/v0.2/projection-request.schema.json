{
  "$defs": {
    "ProjectionBudget": {
      "additionalProperties": false,
      "properties": {
        "max_bytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "max_items": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "max_bytes",
        "max_items"
      ],
      "type": "object"
    },
    "ProtocolDescriptor": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "type": "object"
    },
    "SchemaVersion": {
      "description": "Supported durable contract versions in the first contract slice.",
      "enum": [
        "0.2.0",
        "0.1.1"
      ],
      "type": "string"
    },
    "Sha256Digest": {
      "description": "A canonical lowercase SHA-256 digest with the `sha256:` prefix.",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "StableId": {
      "description": "A compact stable identifier for phases, gates, decisions, and related records.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
      "type": "string"
    }
  },
  "$id": "urn:project-ledger:schema:projection-request:0.2.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "budget": {
      "$ref": "#/$defs/ProjectionBudget"
    },
    "expected_source_version": {
      "format": "uint64",
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "privacy_profile": {
      "type": "string"
    },
    "project_ref": {
      "type": "string"
    },
    "protocol": {
      "$ref": "#/$defs/ProtocolDescriptor"
    },
    "repository_identity_digest": {
      "anyOf": [
        {
          "$ref": "#/$defs/Sha256Digest"
        },
        {
          "type": "null"
        }
      ]
    },
    "request_id": {
      "$ref": "#/$defs/StableId"
    },
    "requested_fields": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "schema_version": {
      "$ref": "#/$defs/SchemaVersion"
    },
    "trace_ref": {
      "$ref": "#/$defs/StableId"
    }
  },
  "required": [
    "schema_version",
    "request_id",
    "protocol",
    "project_ref",
    "requested_fields",
    "budget",
    "privacy_profile",
    "trace_ref"
  ],
  "title": "ProjectionRequest",
  "type": "object"
}
