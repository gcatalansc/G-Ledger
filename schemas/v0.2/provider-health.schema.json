{
  "$defs": {
    "LedgerTimestamp": {
      "description": "A validated RFC 3339 timestamp with an explicit UTC offset.",
      "format": "date-time",
      "type": "string"
    },
    "ProtocolDescriptor": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "type": "object"
    },
    "ProviderHealthStatus": {
      "enum": [
        "HEALTHY",
        "DEGRADED",
        "UNAVAILABLE",
        "INCOMPATIBLE"
      ],
      "type": "string"
    },
    "SchemaVersion": {
      "description": "Supported durable contract versions in the first contract slice.",
      "enum": [
        "0.2.0",
        "0.1.1"
      ],
      "type": "string"
    },
    "Sha256Digest": {
      "description": "A canonical lowercase SHA-256 digest with the `sha256:` prefix.",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "$id": "urn:project-ledger:schema:provider-health:0.2.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "checked_at": {
      "$ref": "#/$defs/LedgerTimestamp"
    },
    "digest": {
      "$ref": "#/$defs/Sha256Digest"
    },
    "explanation_codes": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "provider_id": {
      "type": "string"
    },
    "provider_version": {
      "type": "string"
    },
    "schema_version": {
      "$ref": "#/$defs/SchemaVersion"
    },
    "status": {
      "$ref": "#/$defs/ProviderHealthStatus"
    },
    "supported_protocols": {
      "items": {
        "$ref": "#/$defs/ProtocolDescriptor"
      },
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "provider_id",
    "provider_version",
    "status",
    "checked_at",
    "supported_protocols",
    "explanation_codes",
    "digest"
  ],
  "title": "ProviderHealthReport",
  "type": "object"
}
