{
  "$defs": {
    "RadarFieldOwner": {
      "enum": [
        "LEDGER",
        "RADAR",
        "SHARED_DISPLAY"
      ],
      "type": "string"
    },
    "RadarFieldOwnershipRule": {
      "additionalProperties": false,
      "properties": {
        "field_path": {
          "type": "string"
        },
        "omission_clears": {
          "type": "boolean"
        },
        "owner": {
          "$ref": "#/$defs/RadarFieldOwner"
        }
      },
      "required": [
        "field_path",
        "owner",
        "omission_clears"
      ],
      "type": "object"
    },
    "SchemaVersion": {
      "description": "Supported durable contract versions in the first contract slice.",
      "enum": [
        "0.2.0",
        "0.1.1"
      ],
      "type": "string"
    },
    "Sha256Digest": {
      "description": "A canonical lowercase SHA-256 digest with the `sha256:` prefix.",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "StableId": {
      "description": "A compact stable identifier for phases, gates, decisions, and related records.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
      "type": "string"
    }
  },
  "$id": "urn:project-ledger:schema:radar:radar-field-ownership-policy:0.1.1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "digest": {
      "$ref": "#/$defs/Sha256Digest"
    },
    "policy_id": {
      "$ref": "#/$defs/StableId"
    },
    "rules": {
      "items": {
        "$ref": "#/$defs/RadarFieldOwnershipRule"
      },
      "type": "array"
    },
    "schema_version": {
      "$ref": "#/$defs/SchemaVersion"
    }
  },
  "required": [
    "schema_version",
    "policy_id",
    "rules",
    "digest"
  ],
  "title": "RadarFieldOwnershipPolicy",
  "type": "object"
}
