{
  "$defs": {
    "PhaseKind": {
      "enum": [
        "DISCOVERY",
        "FORMALIZATION",
        "IMPLEMENTATION",
        "TESTING",
        "AUDIT",
        "RELEASE",
        "MAINTENANCE",
        "OTHER"
      ],
      "type": "string"
    },
    "ProjectLifecycleStatus": {
      "enum": [
        "INITIALIZING",
        "ACTIVE",
        "PAUSED",
        "BLOCKED",
        "COMPLETED",
        "ARCHIVED"
      ],
      "type": "string"
    },
    "RadarStatusMappingRule": {
      "additionalProperties": false,
      "properties": {
        "ledger_status": {
          "$ref": "#/$defs/ProjectLifecycleStatus"
        },
        "phase_kind": {
          "anyOf": [
            {
              "$ref": "#/$defs/PhaseKind"
            },
            {
              "type": "null"
            }
          ]
        },
        "radar_status": {
          "$ref": "#/$defs/SuggestedRadarStatus"
        },
        "rule_code": {
          "type": "string"
        }
      },
      "required": [
        "ledger_status",
        "radar_status",
        "rule_code"
      ],
      "type": "object"
    },
    "SchemaVersion": {
      "description": "Supported durable contract versions in the first contract slice.",
      "enum": [
        "0.2.0",
        "0.1.1"
      ],
      "type": "string"
    },
    "Sha256Digest": {
      "description": "A canonical lowercase SHA-256 digest with the `sha256:` prefix.",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "StableId": {
      "description": "A compact stable identifier for phases, gates, decisions, and related records.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
      "type": "string"
    },
    "SuggestedRadarStatus": {
      "enum": [
        "FORMALIZING",
        "SPEC_READY",
        "IN_DEVELOPMENT",
        "TESTING",
        "AUDITING",
        "BLOCKED",
        "PAUSED",
        "DONE",
        "ARCHIVED"
      ],
      "type": "string"
    }
  },
  "$id": "urn:project-ledger:schema:radar:radar-status-mapping-policy:0.1.1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "digest": {
      "$ref": "#/$defs/Sha256Digest"
    },
    "policy_id": {
      "$ref": "#/$defs/StableId"
    },
    "rules": {
      "items": {
        "$ref": "#/$defs/RadarStatusMappingRule"
      },
      "type": "array"
    },
    "schema_version": {
      "$ref": "#/$defs/SchemaVersion"
    }
  },
  "required": [
    "schema_version",
    "policy_id",
    "rules",
    "digest"
  ],
  "title": "RadarStatusMappingPolicy",
  "type": "object"
}
