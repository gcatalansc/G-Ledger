{
  "$defs": {
    "LedgerTimestamp": {
      "description": "A validated RFC 3339 timestamp with an explicit UTC offset.",
      "format": "date-time",
      "type": "string"
    },
    "RepositoryBindingStatus": {
      "enum": [
        "CURRENT",
        "STALE",
        "UNAVAILABLE",
        "REVOKED",
        "CONFLICTED"
      ],
      "type": "string"
    },
    "RepositoryIdentityMethod": {
      "enum": [
        "EXPLICIT_ID",
        "REMOTE_DIGEST",
        "SIGNED_BINDING",
        "USER_CONFIRMED"
      ],
      "type": "string"
    },
    "ResourceRef": {
      "description": "An absolute, minimized resource reference.",
      "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:.+$",
      "type": "string"
    },
    "SchemaVersion": {
      "description": "Supported durable contract versions in the first contract slice.",
      "enum": [
        "0.2.0",
        "0.1.1"
      ],
      "type": "string"
    },
    "Sha256Digest": {
      "description": "A canonical lowercase SHA-256 digest with the `sha256:` prefix.",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "StableId": {
      "description": "A compact stable identifier for phases, gates, decisions, and related records.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
      "type": "string"
    }
  },
  "$id": "urn:project-ledger:schema:repository-binding:0.2.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "confirmed_by": {
      "anyOf": [
        {
          "$ref": "#/$defs/StableId"
        },
        {
          "type": "null"
        }
      ]
    },
    "created_at": {
      "$ref": "#/$defs/LedgerTimestamp"
    },
    "current_snapshot_digest": {
      "anyOf": [
        {
          "$ref": "#/$defs/Sha256Digest"
        },
        {
          "type": "null"
        }
      ]
    },
    "current_snapshot_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/StableId"
        },
        {
          "type": "null"
        }
      ]
    },
    "digest": {
      "$ref": "#/$defs/Sha256Digest"
    },
    "identity_method": {
      "$ref": "#/$defs/RepositoryIdentityMethod"
    },
    "provenance_ref": {
      "$ref": "#/$defs/ResourceRef"
    },
    "remote_identity_digest": {
      "anyOf": [
        {
          "$ref": "#/$defs/Sha256Digest"
        },
        {
          "type": "null"
        }
      ]
    },
    "repository_binding_id": {
      "$ref": "#/$defs/StableId"
    },
    "repository_ref": {
      "$ref": "#/$defs/StableId"
    },
    "schema_version": {
      "$ref": "#/$defs/SchemaVersion"
    },
    "status": {
      "$ref": "#/$defs/RepositoryBindingStatus"
    },
    "updated_at": {
      "$ref": "#/$defs/LedgerTimestamp"
    },
    "workspace_root_ref": {
      "$ref": "#/$defs/ResourceRef"
    }
  },
  "required": [
    "schema_version",
    "repository_binding_id",
    "repository_ref",
    "workspace_root_ref",
    "identity_method",
    "status",
    "created_at",
    "updated_at",
    "provenance_ref",
    "digest"
  ],
  "title": "RepositoryBinding",
  "type": "object"
}
