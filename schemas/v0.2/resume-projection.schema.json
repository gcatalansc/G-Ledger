{
  "$defs": {
    "CheckpointFreshnessStatus": {
      "enum": [
        "CURRENT",
        "CURRENT_FOR_PROJECT_ONLY",
        "STALE_FOR_REPOSITORY",
        "STALE_FOR_AUTHORITY",
        "SUPERSEDED_BY_NEWER_CHECKPOINT",
        "CONFLICTED",
        "INVALIDATED",
        "UNKNOWN"
      ],
      "type": "string"
    },
    "SchemaVersion": {
      "description": "Supported durable contract versions in the first contract slice.",
      "enum": [
        "0.2.0",
        "0.1.1"
      ],
      "type": "string"
    },
    "Sha256Digest": {
      "description": "A canonical lowercase SHA-256 digest with the `sha256:` prefix.",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "StableId": {
      "description": "A compact stable identifier for phases, gates, decisions, and related records.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
      "type": "string"
    }
  },
  "$id": "urn:project-ledger:schema:resume-projection:0.2.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "active_phase_refs": {
      "items": {
        "$ref": "#/$defs/StableId"
      },
      "type": "array"
    },
    "authority_document_refs": {
      "items": {
        "$ref": "#/$defs/StableId"
      },
      "type": "array"
    },
    "checkpoint_freshness": {
      "$ref": "#/$defs/CheckpointFreshnessStatus"
    },
    "checkpoint_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/StableId"
        },
        {
          "type": "null"
        }
      ]
    },
    "completed_phase_refs": {
      "items": {
        "$ref": "#/$defs/StableId"
      },
      "type": "array"
    },
    "conflict_refs": {
      "items": {
        "$ref": "#/$defs/StableId"
      },
      "type": "array"
    },
    "critical_unknown_refs": {
      "items": {
        "$ref": "#/$defs/StableId"
      },
      "type": "array"
    },
    "current_decision_refs": {
      "items": {
        "$ref": "#/$defs/StableId"
      },
      "type": "array"
    },
    "digest": {
      "$ref": "#/$defs/Sha256Digest"
    },
    "last_material_progress_summary": {
      "type": [
        "string",
        "null"
      ]
    },
    "open_blocker_refs": {
      "items": {
        "$ref": "#/$defs/StableId"
      },
      "type": "array"
    },
    "open_risk_refs": {
      "items": {
        "$ref": "#/$defs/StableId"
      },
      "type": "array"
    },
    "pending_gate_refs": {
      "items": {
        "$ref": "#/$defs/StableId"
      },
      "type": "array"
    },
    "preferred_next_action_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/StableId"
        },
        {
          "type": "null"
        }
      ]
    },
    "project_ref": {
      "type": "string"
    },
    "rendered_token_count": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "schema_version": {
      "$ref": "#/$defs/SchemaVersion"
    },
    "state_digest": {
      "$ref": "#/$defs/Sha256Digest"
    },
    "state_version": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "project_ref",
    "state_version",
    "state_digest",
    "checkpoint_freshness",
    "authority_document_refs",
    "active_phase_refs",
    "completed_phase_refs",
    "current_decision_refs",
    "open_blocker_refs",
    "open_risk_refs",
    "pending_gate_refs",
    "critical_unknown_refs",
    "conflict_refs",
    "rendered_token_count",
    "digest"
  ],
  "title": "ResumeProjection",
  "type": "object"
}
