{
  "$defs": {
    "LedgerTimestamp": {
      "description": "A validated RFC 3339 timestamp with an explicit UTC offset.",
      "format": "date-time",
      "type": "string"
    },
    "ResourceRef": {
      "description": "An absolute, minimized resource reference.",
      "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:.+$",
      "type": "string"
    },
    "SchemaVersion": {
      "description": "Supported durable contract versions in the first contract slice.",
      "enum": [
        "0.2.0",
        "0.1.1"
      ],
      "type": "string"
    },
    "Sha256Digest": {
      "description": "A canonical lowercase SHA-256 digest with the `sha256:` prefix.",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "StableId": {
      "description": "A compact stable identifier for phases, gates, decisions, and related records.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
      "type": "string"
    },
    "UnknownCriticality": {
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH",
        "MATERIAL"
      ],
      "type": "string"
    },
    "UnknownStatus": {
      "enum": [
        "OPEN",
        "RESOLVED",
        "ACCEPTED_UNKNOWN",
        "SUPERSEDED"
      ],
      "type": "string"
    }
  },
  "$id": "urn:project-ledger:schema:unknown-record:0.2.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "blocks": {
      "items": {
        "$ref": "#/$defs/StableId"
      },
      "type": "array"
    },
    "criticality": {
      "$ref": "#/$defs/UnknownCriticality"
    },
    "digest": {
      "$ref": "#/$defs/Sha256Digest"
    },
    "evidence_refs": {
      "items": {
        "$ref": "#/$defs/StableId"
      },
      "type": "array"
    },
    "field_path": {
      "type": "string"
    },
    "opened_at": {
      "$ref": "#/$defs/LedgerTimestamp"
    },
    "provenance_ref": {
      "$ref": "#/$defs/ResourceRef"
    },
    "required_evidence": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "resolution_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/ResourceRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "resolved_at": {
      "anyOf": [
        {
          "$ref": "#/$defs/LedgerTimestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "schema_version": {
      "$ref": "#/$defs/SchemaVersion"
    },
    "statement": {
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/UnknownStatus"
    },
    "subject_kind": {
      "type": "string"
    },
    "subject_ref": {
      "$ref": "#/$defs/StableId"
    },
    "unknown_id": {
      "$ref": "#/$defs/StableId"
    }
  },
  "required": [
    "schema_version",
    "unknown_id",
    "subject_kind",
    "subject_ref",
    "field_path",
    "statement",
    "criticality",
    "status",
    "blocks",
    "required_evidence",
    "evidence_refs",
    "opened_at",
    "provenance_ref",
    "digest"
  ],
  "title": "UnknownRecord",
  "type": "object"
}
