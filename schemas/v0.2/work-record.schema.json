{
  "$defs": {
    "LedgerTimestamp": {
      "description": "A validated RFC 3339 timestamp with an explicit UTC offset.",
      "format": "date-time",
      "type": "string"
    },
    "ResourceRef": {
      "description": "An absolute, minimized resource reference.",
      "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:.+$",
      "type": "string"
    },
    "SchemaVersion": {
      "description": "Supported durable contract versions in the first contract slice.",
      "enum": [
        "0.2.0",
        "0.1.1"
      ],
      "type": "string"
    },
    "Sha256Digest": {
      "description": "A canonical lowercase SHA-256 digest with the `sha256:` prefix.",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "StableId": {
      "description": "A compact stable identifier for phases, gates, decisions, and related records.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
      "type": "string"
    }
  },
  "$id": "urn:project-ledger:schema:work-record:0.2.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "actor_ref": {
      "$ref": "#/$defs/StableId"
    },
    "claim_refs": {
      "items": {
        "$ref": "#/$defs/StableId"
      },
      "type": "array"
    },
    "commit_refs": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "digest": {
      "$ref": "#/$defs/Sha256Digest"
    },
    "evidence_refs": {
      "items": {
        "$ref": "#/$defs/StableId"
      },
      "type": "array"
    },
    "files_or_artifacts": {
      "items": {
        "$ref": "#/$defs/ResourceRef"
      },
      "type": "array"
    },
    "influence": {
      "type": [
        "string",
        "null"
      ]
    },
    "occurred_at": {
      "$ref": "#/$defs/LedgerTimestamp"
    },
    "phase_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/StableId"
        },
        {
          "type": "null"
        }
      ]
    },
    "provenance_ref": {
      "$ref": "#/$defs/ResourceRef"
    },
    "recorded_at": {
      "$ref": "#/$defs/LedgerTimestamp"
    },
    "schema_version": {
      "$ref": "#/$defs/SchemaVersion"
    },
    "summary": {
      "type": "string"
    },
    "task_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/StableId"
        },
        {
          "type": "null"
        }
      ]
    },
    "work_record_id": {
      "$ref": "#/$defs/StableId"
    }
  },
  "required": [
    "schema_version",
    "work_record_id",
    "summary",
    "files_or_artifacts",
    "commit_refs",
    "claim_refs",
    "evidence_refs",
    "actor_ref",
    "occurred_at",
    "recorded_at",
    "provenance_ref",
    "digest"
  ],
  "title": "WorkRecord",
  "type": "object"
}
